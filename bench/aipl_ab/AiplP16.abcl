// AiplP16.abcl — アクター 16 個・粒度 1000。バッチ長 8 で 1 通あたりの費用を測る。
//   並列に走っているなら、コア数より少ないバッチ長では 1 通あたりが増えるはず
//   （2 個なら 2 コアしか使えないので 1 通あたりは 4 個・8 個のときの倍になる）。
//   直列に走っているなら、バッチ長によらず 1 通あたりは一定になる。
//   ＝この比較で「本当に並列に走っているか」が決まる。合計 16000。
class Main {
  var ready = 0;
  var c = 0;
  var w0 = 0;
  var w1 = 0;
  var w2 = 0;
  var w3 = 0;
  var w4 = 0;
  var w5 = 0;
  var w6 = 0;
  var w7 = 0;
  var w8 = 0;
  var w9 = 0;
  var w10 = 0;
  var w11 = 0;
  var w12 = 0;
  var w13 = 0;
  var w14 = 0;
  var w15 = 0;
  method tick() {
    if (ready == 0) {
      ready = 1;
      c = new Collector();
      w0 = new Worker();
      w1 = new Worker();
      w2 = new Worker();
      w3 = new Worker();
      w4 = new Worker();
      w5 = new Worker();
      w6 = new Worker();
      w7 = new Worker();
      w8 = new Worker();
      w9 = new Worker();
      w10 = new Worker();
      w11 = new Worker();
      w12 = new Worker();
      w13 = new Worker();
      w14 = new Worker();
      w15 = new Worker();
    }
    send w0.run(c, 1000);
    send w1.run(c, 1000);
    send w2.run(c, 1000);
    send w3.run(c, 1000);
    send w4.run(c, 1000);
    send w5.run(c, 1000);
    send w6.run(c, 1000);
    send w7.run(c, 1000);
    send w8.run(c, 1000);
    send w9.run(c, 1000);
    send w10.run(c, 1000);
    send w11.run(c, 1000);
    send w12.run(c, 1000);
    send w13.run(c, 1000);
    send w14.run(c, 1000);
    send w15.run(c, 1000);
  }
}
class Worker {
  var acc = 0; var i = 0;
  method run(coll, n) {
    acc = 0;
    i = 0;
    while (i < n) do { acc = acc + 1; i = i + 1; }
    send coll.report(acc);
  }
}
class Collector {
  var total = 0; var got = 0;
  method report(v) {
    total = total + v;
    got = got + 1;
    if (got == 16) {
      got = 0;
      // 合計が合ったときだけ次ラウンドを起こす。誤っていれば止まるので
      // /avm-par の msgs が伸びないことで **外から** 誤りが分かる。
      if (total == 16000) { total = 0; line(80, 300, 680, 300, 2); wait(1); }
      else { total = 0; line(80, 300, 680, 300, 4); }
    }
  }
}
