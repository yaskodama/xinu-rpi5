// AiplSolo.abcl — 4 通のうち 1 通だけが重い（32000 反復、他は 100）
//
//   実験C の **1 コア基準値**。バッチ長 1 は nunits==1 で直列経路に落ち計器に載らないため、
//   バッチ長は 4 のまま「実質 1 コアだけが働く」形にする。
//   AiplEq4（4 コアが同時に 32000 反復）と比べれば、**メモリ帯域の奪い合いの分**が出る。
class Main {
  var ready = 0;
  var c = 0;
  var w0 = 0;
  var w1 = 0;
  var w2 = 0;
  var w3 = 0;
  method tick() {
    if (ready == 0) {
      ready = 1;
      c = new Collector();
      w0 = new Worker();
      w1 = new Worker();
      w2 = new Worker();
      w3 = new Worker();
    }
    send w0.run(c, 32000);
    send w1.run(c, 100);
    send w2.run(c, 100);
    send w3.run(c, 100);
  }
}
class Worker {
  var acc = 0; var i = 0;
  method run(coll, n) {
    acc = 0;
    i = 0;
    while (i < n) do { acc = acc + 1; i = i + 1; }
    send coll.report(acc);
  }
}
class Collector {
  var total = 0; var got = 0;
  method report(v) {
    total = total + v;
    got = got + 1;
    if (got == 4) {
      got = 0;
      // 合計が合ったときだけ次ラウンドを起こす。誤っていれば止まるので
      // /avm-par の msgs が伸びないことで **外から** 誤りが分かる。
      if (total == 32300) { total = 0; line(80, 300, 680, 300, 2); wait(1); }
      else { total = 0; line(80, 300, 680, 300, 4); }
    }
  }
}
