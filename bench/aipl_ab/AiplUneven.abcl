// AiplUneven.abcl — 仕事が **不揃い** な標本（等比: 1000 から 128000 まで倍々）
//
//   実験3「主張の境界」用。ワーカーズ型は 8 通を 4 コアへ **静的に** 2 通ずつ割る
//   ので、重い 2 通を引いたコアの終了時刻が全体を決める（64000+128000 = 192000 反復）。
//   対称SMP型は各コアが空き次第 自分で取るので、走行中に均される。
//   ＝ここは対称SMP型が有利になりうる領域であり、正直に測る。
//   合計は 255000 反復。毎ラウンド検算する。
class Main {
  var ready = 0;
  var c = 0;
  var w0 = 0;
  var w1 = 0;
  var w2 = 0;
  var w3 = 0;
  var w4 = 0;
  var w5 = 0;
  var w6 = 0;
  var w7 = 0;
  method tick() {
    if (ready == 0) {
      ready = 1;
      c = new Collector();
      w0 = new Worker();
      w1 = new Worker();
      w2 = new Worker();
      w3 = new Worker();
      w4 = new Worker();
      w5 = new Worker();
      w6 = new Worker();
      w7 = new Worker();
    }
    send w0.run(c, 1000);
    send w1.run(c, 2000);
    send w2.run(c, 4000);
    send w3.run(c, 8000);
    send w4.run(c, 16000);
    send w5.run(c, 32000);
    send w6.run(c, 64000);
    send w7.run(c, 128000);
  }
}
class Worker {
  var acc = 0; var i = 0;
  method run(coll, n) {
    acc = 0;
    i = 0;
    while (i < n) do { acc = acc + 1; i = i + 1; }
    send coll.report(acc);
  }
}
class Collector {
  var total = 0; var got = 0;
  method report(v) {
    total = total + v;
    got = got + 1;
    if (got == 8) {
      got = 0;
      // 合計が合ったときだけ次ラウンドを起こす。誤っていれば止まるので
      // /avm-par の msgs が伸びないことで **外から** 誤りが分かる。
      if (total == 255000) { total = 0; line(80, 300, 680, 300, 2); wait(1); }
      else { total = 0; line(80, 300, 680, 300, 4); }
    }
  }
}
