// AiplEq2.abcl — 等量 32000 反復 × 2 通（＝2 コアだけが働く）
//
//   実験C「4 コアで本当に 4 倍出るのか」用。バッチ長がコア数に満たないと
//   残りのコアは 1 通も実行しない（core_hits で確認済み）ことを利用して、
//   **仕事を完全に揃えたまま** 使われるコア数だけを 1→4 と変える。
//   ここで 4 倍に届かないぶんは、分割の不均等ではなく D-cache OFF の
//   メモリ帯域（およびロック・配布の固定費）で説明されるはず。

//   ワーカ 2 個・合計 64000 反復。毎ラウンド合計を検算する。
class Main {
  var ready = 0;
  var c = 0;
  var w0 = 0;
  var w1 = 0;
  method tick() {
    if (ready == 0) {
      ready = 1;
      c = new Collector();
      w0 = new Worker();
      w1 = new Worker();
    }
    send w0.run(c, 32000);
    send w1.run(c, 32000);
  }
}
class Worker {
  var acc = 0; var i = 0;
  method run(coll, n) {
    acc = 0;
    i = 0;
    while (i < n) do { acc = acc + 1; i = i + 1; }
    send coll.report(acc);
  }
}
class Collector {
  var total = 0; var got = 0;
  method report(v) {
    total = total + v;
    got = got + 1;
    if (got == 2) {
      got = 0;
      // 合計が合ったときだけ次ラウンドを起こす。誤っていれば止まるので
      // /avm-par の msgs が伸びないことで **外から** 誤りが分かる。
      if (total == 64000) { total = 0; line(80, 300, 680, 300, 2); wait(1); }
      else { total = 0; line(80, 300, 680, 300, 4); }
    }
  }
}
