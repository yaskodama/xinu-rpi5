// AiplSpread32.abcl — ばらつき比 1:32（合計固定）
//
//   実験A「交差点」用。総仕事量を固定したままばらつきだけを振り、
//   ワーカーズ型（静的分割）と対称SMP型（動的分配）が入れ替わる点を探す。
//   予測 makespan: 静的 82100 反復 / 動的 58000 反復（比 1.42）。

//   ワーカ 8 個・合計 128000 反復。毎ラウンド合計を検算する。
class Main {
  var ready = 0;
  var c = 0;
  var w0 = 0;
  var w1 = 0;
  var w2 = 0;
  var w3 = 0;
  var w4 = 0;
  var w5 = 0;
  var w6 = 0;
  var w7 = 0;
  method tick() {
    if (ready == 0) {
      ready = 1;
      c = new Collector();
      w0 = new Worker();
      w1 = new Worker();
      w2 = new Worker();
      w3 = new Worker();
      w4 = new Worker();
      w5 = new Worker();
      w6 = new Worker();
      w7 = new Worker();
    }
    send w0.run(c, 1600);
    send w1.run(c, 2600);
    send w2.run(c, 4300);
    send w3.run(c, 7000);
    send w4.run(c, 11500);
    send w5.run(c, 18900);
    send w6.run(c, 31100);
    send w7.run(c, 51000);
  }
}
class Worker {
  var acc = 0; var i = 0;
  method run(coll, n) {
    acc = 0;
    i = 0;
    while (i < n) do { acc = acc + 1; i = i + 1; }
    send coll.report(acc);
  }
}
class Collector {
  var total = 0; var got = 0;
  method report(v) {
    total = total + v;
    got = got + 1;
    if (got == 8) {
      got = 0;
      // 合計が合ったときだけ次ラウンドを起こす。誤っていれば止まるので
      // /avm-par の msgs が伸びないことで **外から** 誤りが分かる。
      if (total == 128000) { total = 0; line(80, 300, 680, 300, 2); wait(1); }
      else { total = 0; line(80, 300, 680, 300, 4); }
    }
  }
}
