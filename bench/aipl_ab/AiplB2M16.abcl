// AiplB2M16.abcl — 同じ重み集合を 後ろに固めた・16 通に分割
//
//   実験B「分割を細かくすれば静的分割は救えるか」用。同じ重み集合(1..M を正規化)を
//   後ろに固めた（単調増加）。
//   郵便箱は区間を **連続** に 4 等分するので、重い仕事が固まっていれば M を増やしても
//   救えないはず。散らばっていれば平均化されて理想に近づくはず。
//   予測 makespan: 静的 54600 / 動的 37700 反復（比 1.45、理想 32000）。
//   ワーカ 16 個・合計 128000 反復。毎ラウンド合計を検算する。
class Main {
  var ready = 0;
  var c = 0;
  var w0 = 0;
  var w1 = 0;
  var w2 = 0;
  var w3 = 0;
  var w4 = 0;
  var w5 = 0;
  var w6 = 0;
  var w7 = 0;
  var w8 = 0;
  var w9 = 0;
  var w10 = 0;
  var w11 = 0;
  var w12 = 0;
  var w13 = 0;
  var w14 = 0;
  var w15 = 0;
  method tick() {
    if (ready == 0) {
      ready = 1;
      c = new Collector();
      w0 = new Worker();
      w1 = new Worker();
      w2 = new Worker();
      w3 = new Worker();
      w4 = new Worker();
      w5 = new Worker();
      w6 = new Worker();
      w7 = new Worker();
      w8 = new Worker();
      w9 = new Worker();
      w10 = new Worker();
      w11 = new Worker();
      w12 = new Worker();
      w13 = new Worker();
      w14 = new Worker();
      w15 = new Worker();
    }
    send w0.run(c, 900);
    send w1.run(c, 1900);
    send w2.run(c, 2800);
    send w3.run(c, 3800);
    send w4.run(c, 4700);
    send w5.run(c, 5600);
    send w6.run(c, 6600);
    send w7.run(c, 7500);
    send w8.run(c, 8500);
    send w9.run(c, 9400);
    send w10.run(c, 10400);
    send w11.run(c, 11300);
    send w12.run(c, 12200);
    send w13.run(c, 13200);
    send w14.run(c, 14100);
    send w15.run(c, 15100);
  }
}
class Worker {
  var acc = 0; var i = 0;
  method run(coll, n) {
    acc = 0;
    i = 0;
    while (i < n) do { acc = acc + 1; i = i + 1; }
    send coll.report(acc);
  }
}
class Collector {
  var total = 0; var got = 0;
  method report(v) {
    total = total + v;
    got = got + 1;
    if (got == 16) {
      got = 0;
      // 合計が合ったときだけ次ラウンドを起こす。誤っていれば止まるので
      // /avm-par の msgs が伸びないことで **外から** 誤りが分かる。
      if (total == 128000) { total = 0; line(80, 300, 680, 300, 2); wait(1); }
      else { total = 0; line(80, 300, 680, 300, 4); }
    }
  }
}
