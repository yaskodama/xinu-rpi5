// Parallel test WITH a render trigger: collector calls wait() so avm_render
// rasterises the result line to the screen.  Green = merged total correct.
class Main {
  var c = 0;
  var w0 = 0; var w1 = 0; var w2 = 0; var w3 = 0;
  method tick() {
    cls();
    c  = new Collector();
    w0 = new Worker(); w1 = new Worker(); w2 = new Worker(); w3 = new Worker();
    send w0.run(c, 50000);
    send w1.run(c, 50000);
    send w2.run(c, 50000);
    send w3.run(c, 50000);
  }
}
class Worker {
  var acc = 0; var i = 0;
  method run(coll, n) {
    acc = 0;
    i = 0;
    while (i < n) do { acc = acc + 1; i = i + 1; }
    send coll.report(acc);
  }
}
class Collector {
  var frame = 0; var total = 0; var got = 0;
  method report(v) {
    total = total + v;
    got = got + 1;
    if (got == 4) {
      if (total == 200000) { line(80, 300, 680, 300, 2); }
      else { line(80, 300, 680, 300, 4); }
      wait(50);
    }
  }
}
