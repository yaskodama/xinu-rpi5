// ParallelTest.abcl — 4 par_safe Worker actors each loop 500000 in PARALLEL
// (distinct par_safe targets -> batched across cores), then report to the
// Collector which draws GREEN if the merged total is exactly 2000000 (proves
// the per-core send buffers + merge are race-free), else RED.
class Main {
  var c = 0;
  var w0 = 0; var w1 = 0; var w2 = 0; var w3 = 0;
  method tick() {
    cls();
    c  = new Collector();
    w0 = new Worker(); w1 = new Worker(); w2 = new Worker(); w3 = new Worker();
    send w0.run(c, 500000);
    send w1.run(c, 500000);
    send w2.run(c, 500000);
    send w3.run(c, 500000);
  }
}
class Worker {
  var acc = 0; var i = 0;
  method run(coll, n) {
    acc = 0;
    i = 0;
    while (i < n) do { acc = acc + 1; i = i + 1; }
    send coll.report(acc);
  }
}
class Collector {
  var total = 0; var got = 0;
  method report(v) {
    total = total + v;
    got = got + 1;
    if (got == 4) {
      if (total == 2000000) { line(80, 300, 680, 300, 2); }
      else { line(80, 300, 680, 300, 4); }
    }
  }
}
